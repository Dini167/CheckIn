# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים.
# אל תעלי את קובץ .env ל-GitHub!

# development / production / test
NODE_ENV=development

# הפורט שהשרת מאזין לו (בענן הוא נקבע אוטומטית)
PORT=3000

# כתובת החיבור למסד הנתונים PostgreSQL
# להרצה מקומית עם "npm run db:local":
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/attendance

# מפתח סודי לחתימת טוקנים — לפחות 32 תווים אקראיים
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# כמה זמן טוקן תקף (למשל 12h, 1d)
JWT_EXPIRES_IN=12h

# מאילו כתובות מותר לאתר ה-React לפנות לשרת (מופרדות בפסיק). * = כולן
CORS_ORIGINS=http://localhost:5173

# אזור הזמן של החברה
APP_TIMEZONE=Asia/Jerusalem

# סיסמאות לחשבונות ההדגמה של ה-Seed (חובה בסביבת production)
SEED_LEADER_PASSWORD=
SEED_EMPLOYEE_PASSWORD=
